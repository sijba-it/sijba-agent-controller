[Unit]
Description=SIJBA Agent Controller
After=network.target

[Service]
Type=simple
User=robert
WorkingDirectory=/home/robert/sijba-agent-controller
Environment=SIJBA_URL=https://sijba.edv-bartl.at
Environment=SIJBA_TOKEN=your-token-here
Environment=WORKSPACE_ROOTS=/home/robert/workspaces/sijba
# Optional: enable free-text control via LLM tool-calling (OpenRouter).
# Leave unset to require exact "controller <cmd> ..." syntax.
#Environment=LLM_API_URL=https://openrouter.ai/api/v1
#Environment=LLM_API_KEY=
#Environment=LLM_MODEL=openai/gpt-4o-mini
ExecStart=/home/robert/sijba-agent-controller/.venv/bin/python controller.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
